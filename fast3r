import os
import torch
import numpy as np
import open3d as o3d
from google.colab import files
from fast3r.dust3r.utils.image import load_images
from fast3r.dust3r.inference_multiview import inference
from fast3r.models.fast3r import Fast3R
from fast3r.models.multiview_dust3r_module import MultiViewDUSt3RLitModule

os.environ["PYTORCH_FORCE_DISABLE_SDPA"] = "1"
os.environ["CUDA_LAUNCH_BLOCKING"] = "1"
torch.backends.cuda.enable_flash_sdp(False)
torch.backends.cuda.enable_mem_efficient_sdp(False)
torch.backends.cuda.enable_math_sdp(True)

uploaded = files.upload()
img_paths = list(uploaded.keys())

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

model = Fast3R.from_pretrained("jedyang97/Fast3R_ViT_Large_512").to(device).eval()
lit = MultiViewDUSt3RLitModule.load_for_inference(model)
lit.eval()

images = load_images(img_paths, size=512, verbose=True)

out, _ = inference(images, model, device, dtype=torch.float32, verbose=True, profiling=False)

poses, focals = MultiViewDUSt3RLitModule.estimate_camera_poses(
    out['preds'],
    niter_PnP=100,
    focal_length_estimation_method='first_view_from_global_head'
)

poses = poses[0]

pc_all = []
for i, pred in enumerate(out['preds']):
    pts = pred['pts3d_in_other_view'][0].cpu().numpy().reshape(-1,3)
    pose = poses[i].cpu().numpy()
    ones = np.ones((pts.shape[0],1))
    homo = np.concatenate([pts,ones],1)
    world = (pose @ homo.T).T[:,:3]
    pc_all.append(world)

pc_all = np.concatenate(pc_all,0)

pcd = o3d.geometry.PointCloud()
pcd.points = o3d.utility.Vector3dVector(pc_all)
pcd = pcd.voxel_down_sample(0.002)
pcd.estimate_normals()

mesh, _ = o3d.geometry.TriangleMesh.create_from_point_cloud_poisson(
    pcd, depth=10
)

bbox = pcd.get_axis_aligned_bounding_box()
mesh = mesh.crop(bbox)

o3d.io.write_triangle_mesh("fast3r_mesh.ply", mesh)
print("Mesh saved: fast3r_mesh.ply")

files.download("fast3r_mesh.ply")

import pythreejs as p3
from google.colab.output import enable_custom_widget_manager
enable_custom_widget_manager()

verts = np.asarray(mesh.vertices)
faces = np.asarray(mesh.triangles)

geometry = p3.BufferGeometry(
    attributes={
        'position': p3.BufferAttribute(verts.astype('float32')),
        'index': p3.BufferAttribute(faces.astype('uint32'))
    }
)

material = p3.MeshNormalMaterial()
mesh3 = p3.Mesh(geometry, material)

scene = p3.Scene(children=[mesh3, p3.AmbientLight()])
camera = p3.PerspectiveCamera(position=[0,0,1], fov=60)
renderer = p3.Renderer(camera=camera, scene=scene, controls=[p3.OrbitControls(controlling=camera)], width=600, height=600)

renderer
